# ───── رمزها (حتماً عوض کنید؛ مثلاً با: openssl rand -hex 32) ─────
POSTGRES_PASSWORD=change-me-db
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
OTP_SECRET=change-me-otp-secret
MINIO_ACCESS_KEY=madrese
MINIO_SECRET_KEY=change-me-minio-secret

# ───── نشانی و کوکی ─────
PUBLIC_URL=https://madresehedayat.ir
WEB_PORT=8080
# پشت HTTPS بگذارید true؛ برای آزمایش روی http محلی false
COOKIE_SECURE=true

# ───── پیامک ─────
# console = کد ورود فقط در لاگ API نوشته می‌شود (برای آزمایش)
# kavenegar = ارسال واقعی با قالب تأییدشدهٔ کاوه‌نگار
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=madrese-otp

# ───── راه‌اندازی ─────
# این شماره‌ها با اولین ورود نقش «مدیر ستاد» می‌گیرند (با ویرگول جدا)
BOOTSTRAP_ADMIN_MOBILES=09120000000
# true = چند دوره، مسیر و مسجد نمونه هم ساخته می‌شود
SEED_DEMO=false

# ───── ایمیج‌ها و مخزن بسته‌ها (اگر Docker Hub یا npm از سرور در دسترس نیست) ─────
# NODE_IMAGE=docker.arvancloud.ir/node:22-alpine
# NGINX_IMAGE=docker.arvancloud.ir/nginx:1.27-alpine
# POSTGRES_IMAGE=docker.arvancloud.ir/postgres:16-alpine
# MINIO_IMAGE=docker.arvancloud.ir/minio/minio:RELEASE.2025-04-22T22-12-26Z
# NPM_REGISTRY=https://registry.npmjs.org/
