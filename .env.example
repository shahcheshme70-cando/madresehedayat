# ───── رمزها (حتماً عوض کنید؛ مثلاً با: openssl rand -hex 32) ─────
POSTGRES_PASSWORD=change-me-db
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
OTP_SECRET=change-me-otp-secret
MINIO_ACCESS_KEY=madrese
MINIO_SECRET_KEY=change-me-minio-secret
# کلید رمزگذاری شماره‌ها، گزارش‌ها، پیام‌ها و برگه‌ها در پایگاه داده (openssl rand -base64 32)
# مهم: اگر گم شود آن داده‌ها دیگر خوانده نمی‌شوند؛ جدا و امن نگه‌اش دارید و بعد از راه‌اندازی عوضش نکنید
DATA_KEY=

# ───── نشانی و کوکی ─────
PUBLIC_URL=https://madresehedayat.ir
WEB_PORT=8080
# پشت HTTPS بگذارید true؛ برای آزمایش روی http محلی false
COOKIE_SECURE=true

# ───── پیامک ─────
# console = کد ورود فقط در لاگ API نوشته می‌شود (برای آزمایش)
# kavenegar = ارسال واقعی با قالب تأییدشدهٔ کاوه‌نگار
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=madrese-otp

# ───── بات بله (اعلان‌ها) ─────
# توکن را از @botfather در بله بگیرید؛ نام کاربری بات بدون @
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=

# ───── برنامهٔ ایتا (eitaayar.ir ← برنامه) ─────
# نشانی مقصد برنامه را در پنل ایتایار بگذارید: https://دامنه/?eitaa=1
EITAA_APP_TOKEN=
# نشانی برنامه در ایتا، برای دکمهٔ «باز کردن در ایتا» در تنظیمات
EITAA_APP_URL=
# فقط اگر می‌خواهید مدرسه در نسخهٔ وب ایتا (داخل iframe) هم کار کند: none (نیاز به HTTPS)
COOKIE_SAMESITE=lax

# ───── کلاس زنده (BigBlueButton) ─────
# نشانی API سرور BBB (معمولاً https://bbb.دامنه/bigbluebutton/api) و رمز مشترک آن (bbb-conf --secret)
# خالی بماند = گزینهٔ «کلاس روی سرور مدرسه» خاموش است و فقط پیوند بیرونی کار می‌کند
BBB_URL=
BBB_SECRET=
# sha1 یا sha256 (پیش‌فرض sha1 که همهٔ نسخه‌ها می‌پذیرند؛ BBB ۲٫۶ به بعد sha256 هم دارد)
BBB_CHECKSUM=sha1

# ───── امنیت ─────
# رمز دوم کارکنان ستاد (Google Authenticator و مانند آن). فقط برای آزمایش off کنید
STAFF_MFA=on
# پشتیبان روزانهٔ پایگاه داده روی همان سرور؛ ۰ = خاموش
BACKUP_KEEP_DAYS=7

# ───── راه‌اندازی ─────
# این شماره‌ها با اولین ورود نقش «مدیر ستاد» می‌گیرند (با ویرگول جدا)
BOOTSTRAP_ADMIN_MOBILES=09120000000
# true = چند دوره، مسیر و مسجد نمونه هم ساخته می‌شود
SEED_DEMO=false

# ───── ایمیج‌ها و مخزن بسته‌ها (اگر Docker Hub یا npm از سرور در دسترس نیست) ─────
# NODE_IMAGE=docker.arvancloud.ir/node:22-alpine
# NGINX_IMAGE=docker.arvancloud.ir/nginx:1.27-alpine
# POSTGRES_IMAGE=docker.arvancloud.ir/postgres:16-alpine
# MINIO_IMAGE=docker.arvancloud.ir/minio/minio:RELEASE.2025-04-22T22-12-26Z
# NPM_REGISTRY=https://registry.npmjs.org/
